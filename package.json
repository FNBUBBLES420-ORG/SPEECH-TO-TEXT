{
  "name": "speech-to-text-application",
  "version": "2.0.8",
  "description": "Privacy-focused local speech-to-text desktop application for Windows.",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start-electron.cjs",
    "dev": "node scripts/start-electron.cjs --dev",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "npm run lint && npm test",
    "pack": "node scripts/enable-nsis-details.cjs && electron-builder --dir --win --x64",
    "build": "node scripts/enable-nsis-details.cjs && electron-builder --win --x64 --publish never",
    "dist": "node scripts/enable-nsis-details.cjs && electron-builder --win --x64 --publish never",
    "dist:win": "node scripts/enable-nsis-details.cjs && electron-builder --win --x64 --publish never"
  },
  "keywords": [
    "electron",
    "speech-to-text",
    "accessibility",
    "obs",
    "whisper"
  ],
  "author": "FNBUBBLES420 Org",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^12.0.0",
    "semver": "^7.8.6"
  },
  "optionalDependencies": {
    "@fugood/whisper.node": "^1.2.0-rc.1",
    "@electron/winstaller": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@electron/get": {
      ".": "5.1.0",
      "undici": "7.30.1"
    },
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.9",
    "http-cache-semantics": "4.3.0",
    "js-yaml": "4.3.2",
    "minimatch": "^11.0.4"
  },
  "build": {
    "appId": "org.fnbubbles420.speech-to-text",
    "productName": "Speech-to-Text Application",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "icon": "assets/icons/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "signExecutable": false
    },
    "nsis": {
      "installerIcon": "assets/icons/app-icon.ico",
      "uninstallerIcon": "assets/icons/app-icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "@fugood/whisper.node@1.2.0-rc.1": true,
    "@electron/winstaller@5.4.0": true,
    "electron-winstaller@5.4.0": true
  }
}
